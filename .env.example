# Application
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# LLM provider: openai or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=

# Local persistence
DATABASE_PATH=data/medboard.db
WORKFLOW_CHECKPOINT_PATH=data/workflow_checkpoints.db
CHROMA_PERSIST_DIRECTORY=data/chroma
KNOWLEDGE_DIRECTORY=data/knowledge
DEMO_CASES_DIRECTORY=data/demo_cases
LOG_DIRECTORY=logs

# Workflow limits
MAX_REVISIONS=2
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=60
RAG_TOP_K=5
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
